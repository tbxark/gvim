{
  "inherits": "default",
  "bindings": [
    {"comment": "C-x C-n: new file", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "n", "modifiers": ["ctrl"]}], "action": "new", "when": "normal"},
    {"comment": "C-x C-f: find file", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "f", "modifiers": ["ctrl"]}], "action": "open", "when": "normal"},
    {"comment": "C-x C-s: save buffer", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "s", "modifiers": ["ctrl"]}], "action": "save", "when": "normal"},
    {"comment": "C-x C-w: write file", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "w", "modifiers": ["ctrl"]}], "action": "save_as", "when": "normal"},
    {"comment": "C-x C-c: quit", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "c", "modifiers": ["ctrl"]}], "action": "quit", "when": "normal"},
    {"comment": "C-x k: kill buffer (close the tab)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "k", "modifiers": []}], "action": "close", "when": "normal"},
    {"comment": "C-x h: mark the whole buffer", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "h", "modifiers": []}], "action": "select_all", "when": "normal"},
    {"comment": "C-x d: dired (file explorer)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "d", "modifiers": []}], "action": "toggle_file_explorer", "when": "normal"},
    {"comment": "C-x 2: split below", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "2", "modifiers": []}], "action": "split_horizontal", "when": "normal"},
    {"comment": "C-x 3: split right", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "3", "modifiers": []}], "action": "split_vertical", "when": "normal"},
    {"comment": "C-x 0: delete window", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "0", "modifiers": []}], "action": "close_split", "when": "normal"},
    {"comment": "C-x o: other window", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "o", "modifiers": []}], "action": "next_split", "when": "normal"},
    {"comment": "C-x Right: next buffer", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "Right", "modifiers": []}], "action": "next_buffer", "when": "normal"},
    {"comment": "C-x Left: previous buffer", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "Left", "modifiers": []}], "action": "prev_buffer", "when": "normal"},
    {"comment": "C-x f: fold or unfold at the cursor", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "f", "modifiers": []}], "action": "toggle_fold", "when": "normal"},
    {"comment": "M-g g: go to line", "keys": [{"key": "g", "modifiers": ["alt"]}, {"key": "g", "modifiers": []}], "action": "goto_line", "when": "normal"},
    {"comment": "M-x: command palette", "key": "x", "modifiers": ["alt"], "action": "quick_open", "when": "global"},
    {"comment": "C-p is previous-line here, not quick open", "key": "p", "modifiers": ["ctrl"], "action": "noop", "when": "global"},
    {"comment": "C-n: next line", "key": "n", "modifiers": ["ctrl"], "action": "move_down", "when": "normal"},
    {"comment": "C-p: previous line", "key": "p", "modifiers": ["ctrl"], "action": "move_up", "when": "normal"},
    {"comment": "C-b: backward character", "key": "b", "modifiers": ["ctrl"], "action": "move_left", "when": "normal"},
    {"comment": "C-f: forward character", "key": "f", "modifiers": ["ctrl"], "action": "move_right", "when": "normal"},
    {"comment": "C-a: beginning of line", "key": "a", "modifiers": ["ctrl"], "action": "move_line_start", "when": "normal"},
    {"comment": "C-e: end of line", "key": "e", "modifiers": ["ctrl"], "action": "move_line_end", "when": "normal"},
    {"comment": "M-f: forward word", "key": "f", "modifiers": ["alt"], "action": "move_word_right", "when": "normal"},
    {"comment": "M-b: backward word", "key": "b", "modifiers": ["alt"], "action": "move_word_left", "when": "normal"},
    {"comment": "M-<: beginning of buffer", "key": "<", "modifiers": ["alt"], "action": "move_document_start", "when": "normal"},
    {"comment": "M->: end of buffer", "key": ">", "modifiers": ["alt"], "action": "move_document_end", "when": "normal"},
    {"comment": "C-v: page down", "key": "v", "modifiers": ["ctrl"], "action": "move_page_down", "when": "normal"},
    {"comment": "M-v: page up", "key": "v", "modifiers": ["alt"], "action": "move_page_up", "when": "normal"},
    {"comment": "C-w: kill region", "key": "w", "modifiers": ["ctrl"], "action": "cut", "when": "normal"},
    {"comment": "M-w: copy region", "key": "w", "modifiers": ["alt"], "action": "copy", "when": "normal"},
    {"comment": "C-y: yank", "key": "y", "modifiers": ["ctrl"], "action": "paste", "when": "normal"},
    {"comment": "C-g: keyboard quit", "key": "g", "modifiers": ["ctrl"], "action": "remove_secondary_cursors", "when": "normal"},
    {"comment": "C-d: delete character forward", "key": "d", "modifiers": ["ctrl"], "action": "delete_forward", "when": "normal"},
    {"comment": "M-DEL: delete word backward", "key": "Backspace", "modifiers": ["alt"], "action": "delete_word_backward", "when": "normal"},
    {"comment": "C-S-DEL: kill the whole line", "key": "Delete", "modifiers": ["ctrl", "shift"], "action": "delete_line", "when": "normal"},
    {"comment": "M-;: comment", "key": ";", "modifiers": ["alt"], "action": "toggle_comment", "when": "normal"},
    {"comment": "M-.: find definition", "key": ".", "modifiers": ["alt"], "action": "lsp_goto_definition", "when": "normal"},
    {"comment": "M-,: pop back", "key": ",", "modifiers": ["alt"], "action": "navigate_back", "when": "normal"},
    {"comment": "C-/: undo", "key": "/", "modifiers": ["ctrl"], "action": "undo", "when": "normal"},
    {"comment": "M-_: redo", "key": "_", "modifiers": ["alt"], "action": "redo", "when": "normal"},
    {"comment": "C-s: isearch forward", "key": "s", "modifiers": ["ctrl"], "action": "search", "when": "normal"},
    {"comment": "C-r: isearch backward", "key": "r", "modifiers": ["ctrl"], "action": "find_previous", "when": "normal"},
    {"comment": "M-%: query replace", "key": "%", "modifiers": ["alt"], "action": "query_replace", "when": "normal"},
    {"comment": "M-n: add a cursor at the next match", "key": "n", "modifiers": ["alt"], "action": "add_cursor_next_match", "when": "normal"},
    {"comment": "C-z suspends in Emacs, so it does nothing here", "key": "z", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "C-c is not copy in Emacs", "key": "c", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "C-q is quoted-insert in Emacs, not quit", "key": "q", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "C-o is open-line in Emacs, not open", "key": "o", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "C-x C-w saves as", "key": "s", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-S-DEL", "key": "k", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Find previous is C-r", "key": "F3", "modifiers": ["shift"], "action": "noop", "when": "normal"},
    {"comment": "Esc is the Meta prefix in Emacs; C-g cancels", "key": "Escape", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Moved to M-,", "key": "Left", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"comment": "Moved to M-.", "key": "F12", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Emacs has no F8 error key (its next-error is M-g n); the palette has Jump to Next Error", "key": "F8", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Emacs has no Shift+F8 error key; the palette has Jump to Previous Error", "key": "F8", "modifiers": ["shift"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-x Left", "key": "PageUp", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-x Right", "key": "PageDown", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-x 3", "key": "\\", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-x 2", "key": "\\", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-x 0", "key": "w", "modifiers": ["alt", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Moved to C-x o", "key": "]", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"comment": "Alt+X is the palette in this keymap", "key": "p", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "global"},
    {"comment": "M-< goes to the start", "key": "Home", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "M-> goes to the end", "key": "End", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "M-b goes back a word", "key": "Left", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "M-f goes forward a word", "key": "Right", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "M-DEL deletes the word back", "key": "Backspace", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "M-v pages up", "key": "PageUp", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "C-v pages down", "key": "PageDown", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "File explorer - C-n/C-p to move, C-g / Esc back to the editor", "key": "n", "modifiers": ["ctrl"], "action": "file_explorer_down", "when": "file_explorer"},
    {"key": "p", "modifiers": ["ctrl"], "action": "file_explorer_up", "when": "file_explorer"},
    {"key": "g", "modifiers": ["ctrl"], "action": "focus_editor", "when": "file_explorer"},
    {"key": "Escape", "modifiers": [], "action": "focus_editor", "when": "file_explorer"}
  ]
}
