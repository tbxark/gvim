{
  "inherits": "macos",
  "bindings": [
    {"comment": "Cmd+S saves", "key": "s", "modifiers": ["super"], "action": "save", "when": "normal"},
    {"comment": "Cmd+S here", "key": "s", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+S saves as", "key": "s", "modifiers": ["super", "shift"], "action": "save_as", "when": "normal"},
    {"comment": "Cmd+Shift+S here", "key": "s", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+O opens", "key": "o", "modifiers": ["super"], "action": "open", "when": "normal"},
    {"comment": "Cmd+O here", "key": "o", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+N new file", "key": "n", "modifiers": ["super"], "action": "new", "when": "normal"},
    {"comment": "Cmd+N here", "key": "n", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+W closes the tab", "key": "w", "modifiers": ["super"], "action": "close_tab", "when": "normal"},
    {"comment": "Cmd+W here", "key": "w", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Q quits", "key": "q", "modifiers": ["super"], "action": "quit", "when": "normal"},
    {"comment": "Cmd+Q here", "key": "q", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Z undoes", "key": "z", "modifiers": ["super"], "action": "undo", "when": "normal"},
    {"comment": "Cmd+Z here", "key": "z", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+Z redoes", "key": "z", "modifiers": ["super", "shift"], "action": "redo", "when": "normal"},
    {"comment": "Cmd+Shift+Z here", "key": "r", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+Z here", "key": "y", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+W here", "key": "w", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+G here", "key": "F3", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+G here", "key": "F3", "modifiers": ["shift"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+C copies", "key": "c", "modifiers": ["super"], "action": "copy", "when": "normal"},
    {"comment": "Cmd+C here", "key": "c", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+X cuts", "key": "x", "modifiers": ["super"], "action": "cut", "when": "normal"},
    {"comment": "Cmd+X here", "key": "x", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+V pastes", "key": "v", "modifiers": ["super"], "action": "paste", "when": "normal"},
    {"comment": "Cmd+V here", "key": "v", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+A selects all", "key": "a", "modifiers": ["super"], "action": "select_all", "when": "normal"},
    {"comment": "Cmd+A here", "key": "a", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+F finds", "key": "f", "modifiers": ["super"], "action": "search", "when": "normal"},
    {"comment": "Cmd+F here", "key": "f", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+G finds next", "key": "g", "modifiers": ["super"], "action": "find_next", "when": "normal"},
    {"comment": "Cmd+G here", "key": "g", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+G finds previous", "key": "g", "modifiers": ["super", "shift"], "action": "find_previous", "when": "normal"},
    {"comment": "Cmd+H replaces", "key": "h", "modifiers": ["super"], "action": "replace", "when": "normal"},
    {"comment": "Cmd+H here", "key": "r", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+P quick open", "key": "p", "modifiers": ["super"], "action": "quick_open", "when": "global"},
    {"comment": "Cmd+P here", "key": "p", "modifiers": ["ctrl"], "action": "noop", "when": "global"},
    {"comment": "Cmd+Shift+P command palette", "key": "p", "modifiers": ["super", "shift"], "action": "command_palette", "when": "global"},
    {"comment": "Cmd+Shift+P here", "key": "t", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+D adds a cursor at the next match", "key": "d", "modifiers": ["super"], "action": "add_cursor_next_match", "when": "normal"},
    {"comment": "Cmd+D here", "key": "d", "modifiers": ["ctrl", "alt"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+L goes to a line", "key": "l", "modifiers": ["super"], "action": "goto_line", "when": "normal"},
    {"comment": "Cmd+L here", "key": "l", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+/ comments", "key": "/", "modifiers": ["super"], "action": "toggle_comment", "when": "normal"},
    {"comment": "Cmd+/ here", "key": "/", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+B shows the explorer", "key": "b", "modifiers": ["super"], "action": "toggle_file_explorer", "when": "normal"},
    {"comment": "Cmd+B here", "key": "b", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+E focuses the explorer", "key": "e", "modifiers": ["super"], "action": "focus_file_explorer", "when": "normal"},
    {"comment": "Cmd+E here", "key": "e", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+K deletes the line", "key": "k", "modifiers": ["super", "shift"], "action": "delete_line", "when": "normal"},
    {"comment": "Cmd+Shift+K here", "key": "k", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+D duplicates the line", "key": "d", "modifiers": ["super", "shift"], "action": "duplicate_line", "when": "normal"},
    {"comment": "Cmd+Shift+D here", "key": "d", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Up goes to the start", "key": "Up", "modifiers": ["super"], "action": "move_document_start", "when": "normal"},
    {"comment": "Cmd+Up here", "key": "Home", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Down goes to the end", "key": "Down", "modifiers": ["super"], "action": "move_document_end", "when": "normal"},
    {"comment": "Cmd+Down here", "key": "End", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Left goes to the line start", "key": "Left", "modifiers": ["super"], "action": "smart_home", "when": "normal"},
    {"comment": "Cmd+Right goes to the line end", "key": "Right", "modifiers": ["super"], "action": "move_line_end", "when": "normal"},
    {"comment": "Cmd+Shift+Up selects to the start", "key": "Up", "modifiers": ["super", "shift"], "action": "select_document_start", "when": "normal"},
    {"comment": "Cmd+Shift+Up here", "key": "Home", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+Down selects to the end", "key": "Down", "modifiers": ["super", "shift"], "action": "select_document_end", "when": "normal"},
    {"comment": "Cmd+Shift+Down here", "key": "End", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+Left selects to the line start", "key": "Left", "modifiers": ["super", "shift"], "action": "select_smart_home", "when": "normal"},
    {"comment": "Cmd+Shift+Right selects to the line end", "key": "Right", "modifiers": ["super", "shift"], "action": "select_line_end", "when": "normal"},
    {"comment": "Cmd+Option+Up adds a cursor above", "key": "Up", "modifiers": ["super", "alt"], "action": "add_cursor_above", "when": "normal"},
    {"comment": "Cmd+Option+Up here", "key": "Up", "modifiers": ["ctrl", "alt"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Option+Down adds a cursor below", "key": "Down", "modifiers": ["super", "alt"], "action": "add_cursor_below", "when": "normal"},
    {"comment": "Cmd+Option+Down here", "key": "Down", "modifiers": ["ctrl", "alt"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+[ navigates back", "key": "[", "modifiers": ["super"], "action": "navigate_back", "when": "normal"},
    {"comment": "Cmd+[ here", "key": "-", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+] navigates forward", "key": "]", "modifiers": ["super"], "action": "navigate_forward", "when": "normal"},
    {"comment": "Cmd+] here", "key": "=", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Cmd+Shift+F searches the files", "key": "f", "modifiers": ["super", "shift"], "action": "open_live_grep", "when": "normal"},
    {"comment": "Cmd+Shift+F here", "key": "/", "modifiers": ["alt"], "action": "noop", "when": "normal"},
    {"key": "b", "modifiers": ["super"], "action": "focus_editor", "when": "file_explorer"},
    {"key": "e", "modifiers": ["super"], "action": "focus_editor", "when": "file_explorer"},
    {"comment": "Terminal: Cmd+V -> Paste", "key": "v", "modifiers": ["super"], "action": "terminal_paste", "when": "terminal"}
  ]
}
