{
  "inherits": "default",
  "bindings": [
    {"comment": "Ctrl+R redoes (Ctrl+Y also does)", "key": "r", "modifiers": ["ctrl"], "action": "redo", "when": "normal"},
    {"comment": "Replace (Ctrl+R is redo here)", "key": "r", "modifiers": ["alt"], "action": "replace", "when": "normal"},
    {"comment": "Cut the line", "key": "k", "modifiers": ["ctrl"], "action": "delete_line", "when": "normal"},
    {"comment": "Moved to Ctrl+K", "key": "k", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Go to line", "key": "l", "modifiers": ["ctrl"], "action": "goto_line", "when": "normal"},
    {"comment": "Find next (Ctrl+G, as in the macOS spec)", "key": "g", "modifiers": ["ctrl"], "action": "find_next", "when": "normal"},
    {"comment": "Command palette (Ctrl+Shift+P does not reach gvim on macOS)", "key": "t", "modifiers": ["ctrl"], "action": "command_palette", "when": "normal"},
    {"comment": "Moved to Ctrl+T", "key": "p", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "global"},
    {"comment": "Navigate back", "key": "-", "modifiers": ["ctrl"], "action": "navigate_back", "when": "normal"},
    {"comment": "Navigate forward", "key": "=", "modifiers": ["ctrl"], "action": "navigate_forward", "when": "normal"},
    {"comment": "Word left (Option+Left)", "key": "Left", "modifiers": ["alt"], "action": "move_word_left", "when": "normal"},
    {"comment": "Word end (Option+Right)", "key": "Right", "modifiers": ["alt"], "action": "move_word_end", "when": "normal"},
    {"comment": "Moved to Option+Left", "key": "Left", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Moved to Option+Right", "key": "Right", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Select word left", "key": "Left", "modifiers": ["alt", "shift"], "action": "select_word_left", "when": "normal"},
    {"comment": "Select word end", "key": "Right", "modifiers": ["alt", "shift"], "action": "select_word_end", "when": "normal"},
    {"comment": "Moved to Option+Shift+Left", "key": "Left", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Moved to Option+Shift+Right", "key": "Right", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Delete word backward (Option+Delete)", "key": "Backspace", "modifiers": ["alt"], "action": "delete_word_backward", "when": "normal"},
    {"comment": "Moved to Option+Delete", "key": "Backspace", "modifiers": ["ctrl"], "action": "noop", "when": "normal"},
    {"comment": "Close tab (Alt+W also closes it)", "key": "w", "modifiers": ["ctrl"], "action": "close_tab", "when": "normal"},
    {"comment": "Save as (Ctrl+Shift+S cannot be sent in a terminal)", "key": "s", "modifiers": ["alt"], "action": "save_as", "when": "normal"},
    {"comment": "Moved to Alt+S", "key": "s", "modifiers": ["ctrl", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Go to definition", "key": ".", "modifiers": ["ctrl"], "action": "lsp_goto_definition", "when": "normal"},
    {"comment": "Moved to Ctrl+.", "key": "F12", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Find references", "key": ",", "modifiers": ["ctrl"], "action": "lsp_references", "when": "normal"},
    {"comment": "Moved to Ctrl+,", "key": "F12", "modifiers": ["shift"], "action": "noop", "when": "normal"},
    {"comment": "Moved to Ctrl+' (F8 is a media key on macOS)", "key": "F8", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Jump to Previous Error has no key on macOS; the palette runs it", "key": "F8", "modifiers": ["shift"], "action": "noop", "when": "normal"},
    {"comment": "Ctrl+' -> Next error (replaces F8)", "key": "'", "modifiers": ["ctrl"], "action": "jump_to_next_error", "when": "normal"},
    {"comment": "Rename symbol", "key": "r", "modifiers": ["ctrl", "alt"], "action": "lsp_rename", "when": "normal"},
    {"comment": "Moved to Ctrl+Alt+R", "key": "F2", "modifiers": [], "action": "noop", "when": "normal"},
    {"comment": "Duplicate line", "key": "d", "modifiers": ["ctrl"], "action": "duplicate_line", "when": "normal"},
    {"comment": "Moved to Ctrl+D", "key": "Down", "modifiers": ["alt", "shift"], "action": "noop", "when": "normal"},
    {"comment": "Add cursor at next match", "key": "d", "modifiers": ["ctrl", "alt"], "action": "add_cursor_next_match", "when": "normal"},
    {"key": "b", "modifiers": ["ctrl"], "action": "focus_editor", "when": "file_explorer"},
    {"comment": "Ctrl+\\ -> Toggle keyboard capture (replaces F9)", "key": "\\", "modifiers": ["ctrl"], "action": "toggle_keyboard_capture", "when": "terminal"},
    {"comment": "Ctrl+/ -> Toggle keyboard capture (German keyboard alternative - \\ is hard to type)", "key": "/", "modifiers": ["ctrl"], "action": "toggle_keyboard_capture", "when": "terminal"}
  ]
}
