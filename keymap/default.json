{
  "inherits": null,
  "comment": "",
  "bindings": [
    {"comment": "Quick Open - files, commands (>), buffers (#), go to line (:)", "key": "p", "modifiers": ["ctrl"], "action": "quick_open", "when": "global"},
    {"comment": "Quick Open files - find files in project", "key": "'", "modifiers": ["ctrl"], "action": "quick_open_files", "when": "global"},
    {"comment": "Quick Open buffers - switch between open tabs", "key": ";", "modifiers": ["ctrl"], "action": "quick_open_buffers", "when": "global"},
    {"key": "F10", "modifiers": [], "action": "menu_activate", "when": "global"},
    {"comment": "Global - Fresh's Remote Indicator menu (Local / SSH authority state; gvim's chrome focus cycle is the separate built-in F7). A user can rebind this action like any other keymap binding.", "key": "F6", "modifiers": [], "action": "show_remote_indicator_menu", "when": "global"},
    {"key": "f", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"File"}, "when": "global"},
    {"key": "e", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"Edit"}, "when": "global"},
    {"comment": "Ctrl+E -> Focus file explorer (switch focus between explorer and editor)", "key": "e", "modifiers": ["ctrl"], "action": "focus_file_explorer", "when": "normal"},
    {"key": "v", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"View"}, "when": "global"},
    {"key": "s", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"Selection"}, "when": "global"},
    {"key": "g", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"Go"}, "when": "global"},
    {"key": "h", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"Help"}, "when": "global"},
    {"key": "x", "modifiers": ["alt"], "action": "menu_open", "args": {"name":"Explorer"}, "when": "global"},
    {"comment": "Normal context - Close tab", "key": "w", "modifiers": ["alt"], "action": "close_tab", "when": "normal"},
    {"comment": "Normal context - Basic movement", "key": "Left", "modifiers": [], "action": "move_left", "when": "normal"},
    {"key": "Right", "modifiers": [], "action": "move_right", "when": "normal"},
    {"key": "Up", "modifiers": [], "action": "move_up", "when": "normal"},
    {"key": "Down", "modifiers": [], "action": "move_down", "when": "normal"},
    {"comment": "Normal context - Move line/selection up/down", "key": "Up", "modifiers": ["alt"], "action": "move_line_up", "when": "normal"},
    {"key": "Down", "modifiers": ["alt"], "action": "move_line_down", "when": "normal"},
    {"key": "Home", "modifiers": [], "action": "smart_home", "when": "normal"},
    {"key": "End", "modifiers": [], "action": "move_line_end", "when": "normal"},
    {"key": "PageUp", "modifiers": [], "action": "move_page_up", "when": "normal"},
    {"key": "PageDown", "modifiers": [], "action": "move_page_down", "when": "normal"},
    {"comment": "Normal context - File operations", "key": "s", "modifiers": ["ctrl"], "action": "save", "when": "normal"},
    {"key": "q", "modifiers": ["ctrl"], "action": "quit", "when": "normal"},
    {"key": "o", "modifiers": ["ctrl"], "action": "open", "when": "normal"},
    {"comment": "Ctrl+O - Open file (also available when the file explorer is focused)", "key": "o", "modifiers": ["ctrl"], "action": "open", "when": "fileExplorer"},
    {"comment": "Normal context - Editing", "key": "z", "modifiers": ["ctrl"], "action": "undo", "when": "normal"},
    {"key": "y", "modifiers": ["ctrl"], "action": "redo", "when": "normal"},
    {"key": "Backspace", "modifiers": [], "action": "delete_backward", "when": "normal"},
    {"key": "Delete", "modifiers": [], "action": "delete_forward", "when": "normal"},
    {"key": "Enter", "modifiers": [], "action": "insert_newline", "when": "normal"},
    {"key": "Tab", "modifiers": [], "action": "insert_tab", "when": "normal"},
    {"comment": "Transpose characters (swap char before cursor with char at cursor)", "key": "t", "modifiers": ["ctrl"], "action": "transpose_chars", "when": "normal"},
    {"comment": "Normal context - Document navigation", "key": "Home", "modifiers": ["ctrl"], "action": "move_document_start", "when": "normal"},
    {"key": "End", "modifiers": ["ctrl"], "action": "move_document_end", "when": "normal"},
    {"comment": "Normal context - Word movement", "key": "Left", "modifiers": ["ctrl"], "action": "move_word_left", "when": "normal"},
    {"key": "Right", "modifiers": ["ctrl"], "action": "move_word_end", "when": "normal"},
    {"comment": "Normal context - Toggle sidebar/file explorer visibility", "key": "b", "modifiers": ["ctrl"], "action": "toggle_file_explorer", "when": "normal"},
    {"key": "b", "modifiers": ["alt"], "action": "move_word_left", "when": "normal"},
    {"comment": "Normal context - Selection", "key": "Left", "modifiers": ["shift"], "action": "select_left", "when": "normal"},
    {"key": "Right", "modifiers": ["shift"], "action": "select_right", "when": "normal"},
    {"key": "Up", "modifiers": ["shift"], "action": "select_up", "when": "normal"},
    {"key": "Down", "modifiers": ["shift"], "action": "select_down", "when": "normal"},
    {"key": "Home", "modifiers": ["shift"], "action": "select_smart_home", "when": "normal"},
    {"key": "End", "modifiers": ["shift"], "action": "select_line_end", "when": "normal"},
    {"key": "Home", "modifiers": ["ctrl","shift"], "action": "select_document_start", "when": "normal"},
    {"key": "End", "modifiers": ["ctrl","shift"], "action": "select_document_end", "when": "normal"},
    {"key": "Left", "modifiers": ["ctrl","shift"], "action": "select_word_left", "when": "normal"},
    {"key": "Right", "modifiers": ["ctrl","shift"], "action": "select_word_end", "when": "normal"},
    {"key": "PageUp", "modifiers": ["shift"], "action": "select_page_up", "when": "normal"},
    {"key": "PageDown", "modifiers": ["shift"], "action": "select_page_down", "when": "normal"},
    {"key": "a", "modifiers": ["ctrl"], "action": "select_all", "when": "normal"},
    {"comment": "Normal context - Clipboard", "key": "c", "modifiers": ["ctrl"], "action": "copy", "when": "normal"},
    {"key": "x", "modifiers": ["ctrl"], "action": "cut", "when": "normal"},
    {"key": "v", "modifiers": ["ctrl"], "action": "paste", "when": "normal"},
    {"comment": "Normal context - Word deletion", "key": "Backspace", "modifiers": ["ctrl"], "action": "delete_word_backward", "when": "normal"},
    {"key": "h", "modifiers": ["ctrl"], "action": "delete_word_backward", "when": "normal"},
    {"key": "Delete", "modifiers": ["ctrl"], "action": "delete_word_forward", "when": "normal"},
    {"comment": "Normal context - Delete to end of line (Ctrl+K)", "key": "k", "modifiers": ["ctrl"], "action": "delete_to_line_end", "when": "normal"},
    {"comment": "Normal context - Advanced selection", "key": "w", "modifiers": ["ctrl"], "action": "select_word", "when": "normal"},
    {"key": "l", "modifiers": ["ctrl"], "action": "expand_line_selection", "when": "normal"},
    {"comment": "Transform to uppercase (Alt+U)", "key": "u", "modifiers": ["alt"], "action": "to_upper_case", "when": "normal"},
    {"comment": "Transform to lowercase (Alt+L - Emacs M-l style)", "key": "l", "modifiers": ["alt"], "action": "to_lower_case", "when": "normal"},
    {"comment": "Normal context - Block selection", "key": "Left", "modifiers": ["alt","shift"], "action": "block_select_left", "when": "normal"},
    {"key": "Right", "modifiers": ["alt","shift"], "action": "block_select_right", "when": "normal"},
    {"key": "Up", "modifiers": ["alt","shift"], "action": "block_select_up", "when": "normal"},
    {"key": "Down", "modifiers": ["alt","shift"], "action": "block_select_down", "when": "normal"},
    {"comment": "Normal context - Multi-cursor", "key": "d", "modifiers": ["ctrl"], "action": "add_cursor_next_match", "when": "normal"},
    {"key": "Up", "modifiers": ["ctrl","alt"], "action": "add_cursor_above", "when": "normal"},
    {"key": "Down", "modifiers": ["ctrl","alt"], "action": "add_cursor_below", "when": "normal"},
    {"comment": "VSCode-compatible 'Add Cursor to Line Ends' (Shift+Alt+I) — places a cursor at the end of every line covered by the selection.", "key": "i", "modifiers": ["shift","alt"], "action": "add_cursors_to_line_ends", "when": "normal"},
    {"comment": "Normal context - Search and replace", "key": "f", "modifiers": ["ctrl"], "action": "search", "when": "normal"},
    {"key": "r", "modifiers": ["ctrl"], "action": "replace", "when": "normal"},
    {"comment": "Project-wide Search and Replace panel. Mnemonic: 'A' for All files. Avoids Ctrl+Shift+F because many terminals collapse Ctrl+Shift+letter to Ctrl+letter (Ctrl+Shift+H ≡ Ctrl+H ≡ Backspace, Ctrl+Shift+L ≡ Ctrl+L ≡ form feed). Implements §10 of docs/internal/search-replace-scope-replan-on-widgets.md.", "key": "a", "modifiers": ["alt"], "action": "start_search_replace", "when": "normal"},
    {"comment": "Jump to the next/previous Project Search & Replace match without leaving the editor (issue #2434). Lets you review a large result set one keystroke at a time instead of Down+Enter in the panel then Alt+] back. Ctrl+Alt+Arrow chosen because Alt+n/p and F3 are taken and arrows avoid the Ctrl+[ (ESC) / shifted-punctuation pitfalls.", "key": "Right", "modifiers": ["ctrl","alt"], "action": "search_replace_next_match", "when": "normal"},
    {"key": "Left", "modifiers": ["ctrl","alt"], "action": "search_replace_prev_match", "when": "normal"},
    {"key": "r", "modifiers": ["ctrl","alt"], "action": "query_replace", "when": "normal"},
    {"comment": "Shell command - pipe buffer/selection through shell command to new buffer", "key": "|", "modifiers": ["alt"], "action": "shell_command", "when": "normal"},
    {"comment": "Shell command replace - pipe buffer/selection through shell command and replace", "key": "|", "modifiers": ["alt","shift"], "action": "shell_command_replace", "when": "normal"},
    {"key": "F3", "modifiers": [], "action": "find_next", "when": "normal"},
    {"key": "F3", "modifiers": ["shift"], "action": "find_previous", "when": "normal"},
    {"comment": "Alternative for Shift-F3 (works in more terminals)", "key": "n", "modifiers": ["ctrl","shift"], "action": "find_previous", "when": "normal"},
    {"comment": "Quick find - search for next occurrence of selection", "key": "F3", "modifiers": ["ctrl"], "action": "find_selection_next", "when": "normal"},
    {"comment": "Quick find - search for previous occurrence of selection", "key": "F3", "modifiers": ["ctrl","shift"], "action": "find_selection_previous", "when": "normal"},
    {"comment": "Alternative for Ctrl+F3 (works in more terminals) - find next occurrence of selection", "key": "n", "modifiers": ["alt"], "action": "find_selection_next", "when": "normal"},
    {"comment": "Alternative for Ctrl+Shift+F3 (works in more terminals) - find previous occurrence of selection", "key": "p", "modifiers": ["alt"], "action": "find_selection_previous", "when": "normal"},
    {"comment": "Normal context - Error navigation", "key": "F8", "modifiers": [], "action": "jump_to_next_error", "when": "normal"},
    {"key": "F8", "modifiers": ["shift"], "action": "jump_to_previous_error", "when": "normal"},
    {"comment": "Normal context - Smart editing", "key": "/", "modifiers": ["ctrl"], "action": "toggle_comment", "when": "normal"},
    {"key": "Tab", "modifiers": ["shift"], "action": "dedent_selection", "when": "normal"},
    {"key": "BackTab", "modifiers": [], "action": "dedent_selection", "when": "normal"},
    {"key": "BackTab", "modifiers": ["shift"], "action": "dedent_selection", "when": "normal"},
    {"key": "]", "modifiers": ["ctrl"], "action": "goto_matching_bracket", "when": "normal"},
    {"key": "g", "modifiers": ["ctrl"], "action": "goto_line", "when": "normal"},
    {"key": "n", "modifiers": ["ctrl"], "action": "new", "when": "normal"},
    {"comment": "Normal context - Help", "key": "F1", "modifiers": [], "action": "show_help", "when": "normal"},
    {"key": "F1", "modifiers": ["shift"], "action": "keyboard_shortcuts", "when": "normal"},
    {"comment": "Normal context - Buffer navigation", "key": "PageUp", "modifiers": ["ctrl"], "action": "prev_buffer", "when": "normal"},
    {"key": "PageDown", "modifiers": ["ctrl"], "action": "next_buffer", "when": "normal"},
    {"comment": "Normal context - Tab scrolling", "key": "PageUp", "modifiers": ["alt"], "action": "scroll_tabs_left", "when": "normal"},
    {"key": "PageDown", "modifiers": ["alt"], "action": "scroll_tabs_right", "when": "normal"},
    {"comment": "Normal context - Position history", "key": "Left", "modifiers": ["alt"], "action": "navigate_back", "when": "normal"},
    {"key": "Right", "modifiers": ["alt"], "action": "navigate_forward", "when": "normal"},
    {"comment": "Normal context - LSP", "key": " ", "modifiers": ["ctrl"], "action": "lsp_completion", "when": "normal"},
    {"key": "F2", "modifiers": [], "action": "lsp_rename", "when": "normal"},
    {"key": "F12", "modifiers": [], "action": "lsp_goto_definition", "when": "normal"},
    {"key": "F12", "modifiers": ["shift"], "action": "lsp_references", "when": "normal"},
    {"key": "F12", "modifiers": ["ctrl"], "action": "lsp_implementation", "when": "normal"},
    {"key": ".", "modifiers": ["alt"], "action": "lsp_code_actions", "when": "normal"},
    {"key": "k", "modifiers": ["alt"], "action": "lsp_hover", "when": "normal"},
    {"key": "F5", "modifiers": [], "action": "stop_macro_recording", "when": "normal"},
    {"comment": "Play last recorded macro (F4)", "key": "F4", "modifiers": [], "action": "play_last_macro", "when": "normal"},
    {"comment": "Normal context - Scrolling", "key": "Up", "modifiers": ["ctrl"], "action": "scroll_up", "when": "normal"},
    {"key": "Down", "modifiers": ["ctrl"], "action": "scroll_down", "when": "normal"},
    {"comment": "Jump to previous empty line with selection", "key": "Up", "modifiers": ["ctrl","shift"], "action": "select_to_paragraph_up", "when": "normal"},
    {"comment": "Jump to next empty line with selection", "key": "Down", "modifiers": ["ctrl","shift"], "action": "select_to_paragraph_down", "when": "normal"},
    {"comment": "Normal context - Cancel/Escape", "key": "Escape", "modifiers": [], "action": "remove_secondary_cursors", "when": "normal"},
    {"comment": "Step through an open Code Tour without leaving the editor split, so you can read the code the step is about and still advance. Mnemonic n/p, matching the keys the tour panel itself uses. NOT Ctrl+Alt+brackets: terminals send Ctrl+[ as ESC, so Ctrl+Alt+[ arrived as Escape and closed the tour instead of stepping back — the same pitfall the Search & Replace binding below avoids. Alt+n/p are find-selection, plain Alt+brackets are split navigation. No-ops when no tour is open.", "key": "n", "modifiers": ["ctrl","alt"], "action": "tour_next", "when": "normal"},
    {"key": "p", "modifiers": ["ctrl","alt"], "action": "tour_prev", "when": "normal"},
    {"comment": "Step through the differences of an open Compare Files view (fresh --diff A B) — handled by the compare_files plugin. Alt+F5 / Shift+Alt+F5 are the diff-editor keys VS Code users already know, and are free here. No-ops (with a status message) when no comparison is open.", "key": "F5", "modifiers": ["alt"], "action": "compare_next_difference", "when": "normal"},
    {"key": "F5", "modifiers": ["shift","alt"], "action": "compare_prev_difference", "when": "normal"},
    {"comment": "Move between the two panels of a Compare Files view. Next/Previous Split (Alt+]/Alt+[) step between the editor's splits, not between the panels inside one tab, and both panels are ordinary file buffers that keep every typing key. Ctrl+F6 is the long-standing 'next document pane' key, and free here.", "key": "F6", "modifiers": ["ctrl"], "action": "compare_switch_side", "when": "normal"},
    {"comment": "Normal context - Split navigation", "key": "]", "modifiers": ["alt"], "action": "next_split", "when": "normal"},
    {"key": "[", "modifiers": ["alt"], "action": "prev_split", "when": "normal"},
    {"comment": "Normal context - Set Bookmarks (Ctrl+Shift+0-9)", "key": "0", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"0"}, "when": "normal"},
    {"key": "1", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"1"}, "when": "normal"},
    {"key": "2", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"2"}, "when": "normal"},
    {"key": "3", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"3"}, "when": "normal"},
    {"key": "4", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"4"}, "when": "normal"},
    {"key": "5", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"5"}, "when": "normal"},
    {"key": "6", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"6"}, "when": "normal"},
    {"key": "7", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"7"}, "when": "normal"},
    {"key": "8", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"8"}, "when": "normal"},
    {"key": "9", "modifiers": ["ctrl","shift"], "action": "set_bookmark", "args": {"char":"9"}, "when": "normal"},
    {"comment": "Normal context - Jump to Bookmarks (Alt+0-9)", "key": "0", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"0"}, "when": "normal"},
    {"key": "1", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"1"}, "when": "normal"},
    {"key": "2", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"2"}, "when": "normal"},
    {"key": "3", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"3"}, "when": "normal"},
    {"key": "4", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"4"}, "when": "normal"},
    {"key": "5", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"5"}, "when": "normal"},
    {"key": "6", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"6"}, "when": "normal"},
    {"key": "7", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"7"}, "when": "normal"},
    {"key": "8", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"8"}, "when": "normal"},
    {"key": "9", "modifiers": ["alt"], "action": "jump_to_bookmark", "args": {"char":"9"}, "when": "normal"},
    {"comment": "Transfer keyboard focus to the topmost popup (LSP popups appear unfocused so they don't swallow the next keystroke). Bound in normal/fileExplorer rather than global so a user's own alt+t binding in either context wins at the same precedence level — global defaults would shadow the user's normal-context override.", "key": "t", "modifiers": ["alt"], "action": "popup_focus", "when": "normal"},
    {"key": "t", "modifiers": ["alt"], "action": "popup_focus", "when": "fileExplorer"},
    {"comment": "File Explorer context", "key": "Up", "modifiers": [], "action": "file_explorer_up", "when": "file_explorer"},
    {"key": "Down", "modifiers": [], "action": "file_explorer_down", "when": "file_explorer"},
    {"key": "PageUp", "modifiers": [], "action": "file_explorer_page_up", "when": "file_explorer"},
    {"key": "PageDown", "modifiers": [], "action": "file_explorer_page_down", "when": "file_explorer"},
    {"key": "Enter", "modifiers": [], "action": "file_explorer_open", "when": "file_explorer"},
    {"key": "Right", "modifiers": [], "action": "file_explorer_expand", "when": "file_explorer"},
    {"key": "Left", "modifiers": [], "action": "file_explorer_collapse", "when": "file_explorer"},
    {"key": "r", "modifiers": ["ctrl"], "action": "file_explorer_refresh", "when": "file_explorer"},
    {"comment": "Ctrl+E -> Focus editor (switch focus from explorer to editor)", "key": "e", "modifiers": ["ctrl"], "action": "focus_editor", "when": "file_explorer"},
    {"comment": "Alt+] -> Focus last focused editor split", "key": "]", "modifiers": ["alt"], "action": "focus_editor", "when": "file_explorer"},
    {"comment": "Ctrl+B -> Toggle sidebar/file explorer visibility", "key": "b", "modifiers": ["ctrl"], "action": "toggle_file_explorer", "when": "file_explorer"},
    {"key": "n", "modifiers": ["ctrl"], "action": "file_explorer_new_file", "when": "file_explorer"},
    {"key": "n", "modifiers": ["ctrl","shift"], "action": "file_explorer_new_directory", "when": "file_explorer"},
    {"key": "F2", "modifiers": [], "action": "file_explorer_rename", "when": "file_explorer"},
    {"key": "Delete", "modifiers": [], "action": "file_explorer_delete", "when": "file_explorer"},
    {"key": "i", "modifiers": ["ctrl"], "action": "file_explorer_toggle_gitignored", "when": "file_explorer"},
    {"key": "Escape", "modifiers": [], "action": "file_explorer_search_clear", "when": "file_explorer"},
    {"key": "Backspace", "modifiers": [], "action": "file_explorer_search_backspace", "when": "file_explorer"},
    {"key": "Up", "modifiers": ["shift"], "action": "file_explorer_extend_selection_up", "when": "file_explorer"},
    {"key": "Down", "modifiers": ["shift"], "action": "file_explorer_extend_selection_down", "when": "file_explorer"},
    {"key": " ", "modifiers": [], "action": "file_explorer_toggle_select", "when": "file_explorer"},
    {"key": "a", "modifiers": ["ctrl"], "action": "file_explorer_select_all", "when": "file_explorer"},
    {"key": "c", "modifiers": ["ctrl"], "action": "copy", "when": "file_explorer"},
    {"key": "x", "modifiers": ["ctrl"], "action": "cut", "when": "file_explorer"},
    {"key": "v", "modifiers": ["ctrl"], "action": "paste", "when": "file_explorer"},
    {"comment": "Terminal context - Exit terminal mode (Ctrl+] is the only exit chord; the dock takes Ctrl+Space itself to toggle live/read-only scrollback, see docs/terminal.md)", "key": "]", "modifiers": ["ctrl"], "action": "terminal_escape", "when": "terminal"},
    {"comment": "Terminal context - Toggle keyboard capture (F9)", "key": "F9", "modifiers": [], "action": "toggle_keyboard_capture", "when": "terminal"},
    {"comment": "Terminal context - Paste clipboard contents (Ctrl+V)", "key": "v", "modifiers": ["ctrl"], "action": "terminal_paste", "when": "terminal"},
    {"comment": "Live Grep — open as floating overlay (issue #1796). Bound to Alt+/ rather than Ctrl+Shift+F because most terminals collapse Ctrl+Shift+F to Ctrl+F (which is already buffer-local search). Mnemonic: '/' is the search character in many editors.", "key": "/", "modifiers": ["alt"], "action": "open_live_grep", "when": "normal"},
    {"comment": "Live Grep — Resume with prior query, selection, and cached results without re-running ripgrep (issue #1796). Mnemonic: 'r' for Resume. The same physical key is `toggle_search_regex` in `prompt` context — disjoint contexts, no conflict.", "key": "r", "modifiers": ["alt"], "action": "resume_live_grep", "when": "normal"},
    {"comment": "Utility Dock — focus / unfocus toggle. Avoids Alt+D because Ctrl+D (add_cursor_next_match) is in the multi-cursor cluster and the adjacency is muscle-memory-risky. Mnemonic: 'j' is 'down' in vim-ish navigation, matching the dock's bottom-of-screen home position.", "key": "j", "modifiers": ["alt"], "action": "toggle_utility_dock", "when": "normal"},
    {"comment": "Utility Dock — open a terminal inside the dock (mnemonic: backtick like tmux/VSCode terminal)", "key": "`", "modifiers": ["alt"], "action": "open_terminal_in_dock", "when": "normal"},
    {"comment": "Orchestrator dock — toggle keyboard focus between the editor/explorer area and the persistent left session dock (the dog-picture column). Press once to dive into the dock, again to return to the editor — same key both ways (the Zed/Yazelix focus-toggle model). When the dock is hidden it is opened and focused. Mnemonic: 'O' for Orchestrator. Bound per-context rather than globally so it does not shadow the live-grep prompt's Alt+O (toggle whole-word). The 'dock' binding lets you blur back out from inside the focused dock.", "key": "o", "modifiers": ["alt"], "action": "toggle_dock_focus", "when": "normal"},
    {"key": "o", "modifiers": ["alt"], "action": "toggle_dock_focus", "when": "fileExplorer"},
    {"key": "o", "modifiers": ["alt"], "action": "toggle_dock_focus", "when": "terminal"},
    {"comment": "Sidebar sections — cycle keyboard focus through the sidebar column: the file explorer, then each plugin section under it (the Markdown Contents outline, say), then back to the editor. Alt+Shift+P runs the same cycle the other way. Bound per context, like toggle_dock_focus, so the cycle continues out of the explorer, a section, the dock and a terminal rather than restarting from the editor. A hidden sidebar is shown and its explorer focused first.", "key": "n", "modifiers": ["alt","shift"], "action": "focus_next_sidebar_section", "when": "normal"},
    {"key": "p", "modifiers": ["alt","shift"], "action": "focus_prev_sidebar_section", "when": "normal"},
    {"key": "n", "modifiers": ["alt","shift"], "action": "focus_next_sidebar_section", "when": "fileExplorer"},
    {"key": "p", "modifiers": ["alt","shift"], "action": "focus_prev_sidebar_section", "when": "fileExplorer"},
    {"key": "n", "modifiers": ["alt","shift"], "action": "focus_next_sidebar_section", "when": "terminal"},
