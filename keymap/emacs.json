{
  "inherits": "default",
  "comment": "Emacs keymap. Inherits the default keymap so every context (settings, completion, terminal, search prompt, dock, file explorer, LSP, multi-cursor, ...) keeps a working set of keys, then overrides the ones Emacs users reach for. Only the Emacs-specific bindings live here; anything not listed behaves like the default keymap.",
  "bindings": [
    {"comment": "M-x - execute extended command. Overrides the default Alt+X menu mnemonic. Bound to `quick_open` rather than the identical `command_palette` so the status bar's palette hint (which looks up `quick_open`) names M-x.", "key": "x", "modifiers": ["alt"], "action": "quick_open", "when": "global"},
    {"comment": "C-p is previous-line, everywhere — not the default global palette shortcut, which would leave the status bar advertising a key that moves the cursor instead.", "key": "p", "modifiers": ["ctrl"], "action": "noop", "when": "global"},
    {"comment": "Character/line movement - C-f/C-b/C-n/C-p, C-a/C-e", "key": "f", "modifiers": ["ctrl"], "action": "move_right", "when": "normal"},
    {"key": "b", "modifiers": ["ctrl"], "action": "move_left", "when": "normal"},
    {"key": "n", "modifiers": ["ctrl"], "action": "move_down", "when": "normal"},
    {"key": "p", "modifiers": ["ctrl"], "action": "move_up", "when": "normal"},
    {"key": "a", "modifiers": ["ctrl"], "action": "move_line_start", "when": "normal"},
    {"key": "e", "modifiers": ["ctrl"], "action": "move_line_end", "when": "normal"},
    {"comment": "Home behaves like C-a (true beginning of line), not the default smart-home", "key": "Home", "modifiers": [], "action": "move_line_start", "when": "normal"},
    {"comment": "Shift+Home selects to the true beginning of line too, matching Home above", "key": "Home", "modifiers": ["shift"], "action": "select_line_start", "when": "normal"},
    {"comment": "M-m - back-to-indentation", "key": "m", "modifiers": ["alt"], "action": "smart_home", "when": "normal"},
    {"comment": "Word movement - M-f/M-b and Ctrl+arrows", "key": "f", "modifiers": ["alt"], "action": "move_word_right", "when": "normal"},
    {"key": "b", "modifiers": ["alt"], "action": "move_word_left", "when": "normal"},
    {"key": "Right", "modifiers": ["ctrl"], "action": "move_word_right", "when": "normal"},
    {"comment": "M-< / M-> - beginning/end of buffer. Bound on the shifted character itself: a terminal sends Alt+Shift+, as ESC '<', so `key: \",\"` never matches. The alt+shift variant covers terminals (kitty protocol) that do report Shift alongside the shifted glyph.", "key": "<", "modifiers": ["alt"], "action": "move_document_start", "when": "normal"},
    {"key": "<", "modifiers": ["alt","shift"], "action": "move_document_start", "when": "normal"},
    {"key": ">", "modifiers": ["alt"], "action": "move_document_end", "when": "normal"},
    {"key": ">", "modifiers": ["alt","shift"], "action": "move_document_end", "when": "normal"},
    {"comment": "M-{ / M-} - backward/forward paragraph", "key": "{", "modifiers": ["alt"], "action": "move_to_paragraph_up", "when": "normal"},
    {"key": "{", "modifiers": ["alt","shift"], "action": "move_to_paragraph_up", "when": "normal"},
    {"key": "}", "modifiers": ["alt"], "action": "move_to_paragraph_down", "when": "normal"},
    {"key": "}", "modifiers": ["alt","shift"], "action": "move_to_paragraph_down", "when": "normal"},
    {"comment": "C-v / M-v - page down/up", "key": "v", "modifiers": ["ctrl"], "action": "move_page_down", "when": "normal"},
    {"key": "v", "modifiers": ["alt"], "action": "move_page_up", "when": "normal"},
    {"comment": "Scrolling without moving the cursor - Alt+arrows", "key": "Up", "modifiers": ["alt"], "action": "scroll_up", "when": "normal"},
    {"key": "Down", "modifiers": ["alt"], "action": "scroll_down", "when": "normal"},
    {"comment": "C-l - recenter", "key": "l", "modifiers": ["ctrl"], "action": "recenter", "when": "normal"},
    {"comment": "Clipboard - C-w (kill region), M-w (copy region), C-y (yank)", "key": "w", "modifiers": ["ctrl"], "action": "cut", "when": "normal"},
    {"key": "w", "modifiers": ["alt"], "action": "copy", "when": "normal"},
    {"key": "y", "modifiers": ["ctrl"], "action": "paste", "when": "normal"},
    {"comment": "C-SPC - set mark (start selection)", "key": " ", "modifiers": ["ctrl"], "action": "set_mark", "when": "normal"},
    {"comment": "C-g - keyboard quit: drops extra cursors and cancels mark mode", "key": "g", "modifiers": ["ctrl"], "action": "remove_secondary_cursors", "when": "normal"},
    {"comment": "C-d - delete char forward, M-d - kill word forward, M-DEL - kill word backward", "key": "d", "modifiers": ["ctrl"], "action": "delete_forward", "when": "normal"},
    {"key": "d", "modifiers": ["alt"], "action": "delete_word_forward", "when": "normal"},
    {"key": "Backspace", "modifiers": ["alt"], "action": "delete_word_backward", "when": "normal"},
    {"comment": "C-k - kill to end of line (Emacs kill-line), not the whole line", "key": "k", "modifiers": ["ctrl"], "action": "delete_to_line_end", "when": "normal"},
    {"comment": "C-S-DEL - kill whole line. On the Delete key: `normalize_key` folds Shift off Backspace, so Ctrl+Shift+Backspace would be unreachable behind Ctrl+Backspace.", "key": "Delete", "modifiers": ["ctrl","shift"], "action": "delete_line", "when": "normal"},
    {"comment": "C-t - transpose chars, C-o - open line", "key": "t", "modifiers": ["ctrl"], "action": "transpose_chars", "when": "normal"},
    {"key": "o", "modifiers": ["ctrl"], "action": "open_line", "when": "normal"},
    {"comment": "M-; - comment-dwim", "key": ";", "modifiers": ["alt"], "action": "toggle_comment", "when": "normal"},
    {"comment": "M-/ - dabbrev-expand (overrides the default Alt+/ live grep, which stays on the palette and the Search menu)", "key": "/", "modifiers": ["alt"], "action": "dabbrev_expand", "when": "normal"},
    {"comment": "M-TAB (C-M-i) - completion at point", "key": "Tab", "modifiers": ["alt"], "action": "lsp_completion", "when": "normal"},
    {"comment": "M-. / M-, - xref find definition / pop back", "key": ".", "modifiers": ["alt"], "action": "lsp_goto_definition", "when": "normal"},
    {"key": ",", "modifiers": ["alt"], "action": "navigate_back", "when": "normal"},
    {"comment": "Undo - C-/ and C-_ . `ctrl+-` picks up the `ctrl+_` alias `terminal_key_equivalents` adds for legacy terminals; the explicit `ctrl+shift+-`/`ctrl+shift+_` entries cover terminals (kitty protocol) that report Shift alongside the shifted glyph.", "key": "/", "modifiers": ["ctrl"], "action": "undo", "when": "normal"},
    {"key": "-", "modifiers": ["ctrl"], "action": "undo", "when": "normal"},
    {"key": "_", "modifiers": ["ctrl","shift"], "action": "undo", "when": "normal"},
    {"comment": "Redo - M-_ . Emacs has no redo; this mirrors C-_ so the editor's redo stays reachable (C-y is yank here). Both Alt spellings, as above.", "key": "_", "modifiers": ["alt"], "action": "redo", "when": "normal"},
    {"key": "_", "modifiers": ["alt","shift"], "action": "redo", "when": "normal"},
    {"comment": "C-s - isearch forward (opens the search prompt), C-r - search backwards", "key": "s", "modifiers": ["ctrl"], "action": "search", "when": "normal"},
    {"key": "r", "modifiers": ["ctrl"], "action": "find_previous", "when": "normal"},
    {"comment": "M-% - query replace. Bound on the shifted character; see the M-< note above.", "key": "%", "modifiers": ["alt"], "action": "query_replace", "when": "normal"},
    {"key": "%", "modifiers": ["alt","shift"], "action": "query_replace", "when": "normal"},
    {"comment": "C-x C-s - save buffer", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "s", "modifiers": ["ctrl"]}], "action": "save", "when": "normal"},
    {"comment": "C-x s - save some buffers", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "s", "modifiers": []}], "action": "save_all", "when": "normal"},
    {"comment": "C-x C-w - write file (save as)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "w", "modifiers": ["ctrl"]}], "action": "save_as", "when": "normal"},
    {"comment": "C-x C-f - find file", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "f", "modifiers": ["ctrl"]}], "action": "open", "when": "normal"},
    {"comment": "C-x C-c - save buffers and quit", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "c", "modifiers": ["ctrl"]}], "action": "quit", "when": "normal"},
    {"comment": "C-x k - kill buffer (close)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "k", "modifiers": []}], "action": "close", "when": "normal"},
    {"comment": "C-x b / C-x C-b - switch to buffer / list buffers", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "b", "modifiers": []}], "action": "quick_open_buffers", "when": "normal"},
    {"keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "b", "modifiers": ["ctrl"]}], "action": "quick_open_buffers", "when": "normal"},
    {"comment": "C-x Right / C-x Left - next / previous buffer", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "Right", "modifiers": []}], "action": "next_buffer", "when": "normal"},
    {"keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "Left", "modifiers": []}], "action": "prev_buffer", "when": "normal"},
    {"comment": "C-x u - undo", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "u", "modifiers": []}], "action": "undo", "when": "normal"},
    {"comment": "C-x h - mark whole buffer (select all)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "h", "modifiers": []}], "action": "select_all", "when": "normal"},
    {"comment": "C-x d - dired (file explorer)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "d", "modifiers": []}], "action": "toggle_file_explorer", "when": "normal"},
    {"comment": "C-x o - other window (next split)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "o", "modifiers": []}], "action": "next_split", "when": "normal"},
    {"comment": "C-x 0 - delete window (close split)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "0", "modifiers": []}], "action": "close_split", "when": "normal"},
    {"comment": "C-x 2 - split below (horizontal)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "2", "modifiers": []}], "action": "split_horizontal", "when": "normal"},
    {"comment": "C-x 3 - split right (vertical)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "3", "modifiers": []}], "action": "split_vertical", "when": "normal"},
    {"comment": "M-g g / M-g M-g - goto line", "keys": [{"key": "g", "modifiers": ["alt"]}, {"key": "g", "modifiers": []}], "action": "goto_line", "when": "normal"},
    {"keys": [{"key": "g", "modifiers": ["alt"]}, {"key": "g", "modifiers": ["alt"]}], "action": "goto_line", "when": "normal"},
    {"comment": "File explorer - C-n/C-p to move, C-g / Esc back to the editor", "key": "n", "modifiers": ["ctrl"], "action": "file_explorer_down", "when": "file_explorer"},
    {"key": "p", "modifiers": ["ctrl"], "action": "file_explorer_up", "when": "file_explorer"},
    {"key": "g", "modifiers": ["ctrl"], "action": "focus_editor", "when": "file_explorer"},
    {"key": "Escape", "modifiers": [], "action": "focus_editor", "when": "file_explorer"},
    {"comment": "gvim: new file (Fresh's Emacs preset leaves New without a key)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "n", "modifiers": ["ctrl"]}], "action": "new", "when": "normal"},
    {"comment": "gvim: fold or unfold at the cursor (Fresh has no fold key)", "keys": [{"key": "x", "modifiers": ["ctrl"]}, {"key": "f", "modifiers": []}], "action": "toggle_fold", "when": "normal"},
    {"comment": "Emacs Keys: prompt context", "key": "g", "modifiers": ["ctrl"], "action": "prompt_cancel", "when": "prompt"},
    {"key": "a", "modifiers": ["ctrl"], "action": "prompt_move_start", "when": "prompt"},
    {"key": "f", "modifiers": ["ctrl"], "action": "prompt_move_right", "when": "prompt"},
    {"key": "b", "modifiers": ["ctrl"], "action": "prompt_move_left", "when": "prompt"},
    {"key": "n", "modifiers": ["ctrl"], "action": "prompt_select_next", "when": "prompt"},
    {"key": "p", "modifiers": ["ctrl"], "action": "prompt_select_prev", "when": "prompt"},
    {"key": "d", "modifiers": ["ctrl"], "action": "prompt_delete", "when": "prompt"},
    {"key": "d", "modifiers": ["alt"], "action": "prompt_delete_word_forward", "when": "prompt"},
    {"key": "Backspace", "modifiers": ["alt"], "action": "prompt_delete_word_backward", "when": "prompt"},
    {"key": "y", "modifiers": ["ctrl"], "action": "prompt_paste", "when": "prompt"},
    {"key": "s", "modifiers": ["ctrl"], "action": "find_next", "when": "searchPrompt"},
    {"key": "r", "modifiers": ["ctrl"], "action": "find_previous", "when": "searchPrompt"},
    {"key": "n", "modifiers": ["ctrl"], "action": "popup_select_next", "when": "popup"},
    {"key": "p", "modifiers": ["ctrl"], "action": "popup_select_prev", "when": "popup"},
    {"key": "g", "modifiers": ["ctrl"], "action": "popup_cancel", "when": "popup"},
    {"key": "n", "modifiers": ["ctrl"], "action": "menu_down", "when": "menu"},
    {"key": "p", "modifiers": ["ctrl"], "action": "menu_up", "when": "menu"},
    {"key": "f", "modifiers": ["ctrl"], "action": "menu_right", "when": "menu"},
    {"key": "b", "modifiers": ["ctrl"], "action": "menu_left", "when": "menu"},
    {"key": "g", "modifiers": ["ctrl"], "action": "menu_close", "when": "menu"}
  ]
}
